#fzf
source /usr/share/doc/fzf/examples/key-bindings.bash

alias f='cd "$(project_dirs | fzf)"'

bind '"\C-f":"tmux-sessionizer\n"'

alias fd='fdfind'
alias py='python3'

bind 'set completion-ignore-case on'

if [[ $TMUX ]]; then
    alias clear='clear && tmux clear-history'
fi

export EDITOR=nvim

